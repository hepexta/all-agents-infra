# Profile: local
#
# A local development cluster shaped as closely like the managed cluster as a
# laptop allows. Sourced by scripts/up.sh, scripts/down.sh and scripts/status.sh.
#
# Everything here is an input. The scripts contain no cluster name, node count,
# version or port of their own, so a second profile is a second file.

# Cluster name. The kubectl context is derived as "kind-<name>".
CLUSTER_NAME=agents-infra-local

# Kubernetes version to pin. Keep it inside the range the managed service still
# supports, and pick a node image the installed kind actually publishes.
KUBERNETES_VERSION=1.36.4

# Node image pinned by digest, so a run months from now builds the same cluster
# rather than whatever the tag points at then. Note that kind's own default is
# a newer minor, so this must be set explicitly to stay on the pinned version.
NODE_IMAGE=kindest/node:v1.36.4@sha256:099e049362a1526b2db71494e1947aae99bd16290d7c895f2b7ea312e3cbfaed

# Topology: one control plane plus workers, so that scheduling behaviour which
# depends on more than one node is not flattened away.
CONTROL_PLANE_NODES=1
WORKER_NODES=2

# Host port publications, as "host:node" pairs.
#
# kind maps a host port onto a port on the node, and the two numbers follow the
# node port range: the container port IS the node port, so it must be between
# 30000 and 32767. That is why the database cannot appear on the host port its
# container stack already uses.
#
#   80    -> 30080   HTTP ingress
#   443   -> 30443   HTTPS ingress
#   15433 -> 30433   database through the cluster gateway (off by default)
#
# The database port-forward on 15432 needs no entry here: it is tunnelled
# through the API server rather than published by the container runtime.
#
# Changing this list requires recreating the cluster.
HOST_PORTS="80:30080 443:30443 15433:30433"

# Bind the published ports to the loopback address so the cluster is not
# reachable from the local network.
LISTEN_ADDRESS=127.0.0.1
